# Public browser configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use either the legacy anon key name or the newer publishable key name.
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional on Vercel: wss://your-realtime-host.example.com/duel-ws
VITE_DUEL_WS_URL=

# Production server configuration.
HOST=0.0.0.0
PORT=3000
